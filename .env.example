# Copy to .env and fill in what you use. Leave a provider's key empty to disable it.
# Never commit .env.

# --- Gateway ---
# Port on the host where the gateway (UI + API) is served
HTTP_PORT=8080

# --- Authentication ---
# Every endpoint except the health checks needs a signed-in caller. Until this section
# is filled in, those endpoints return 503 (the gateway locks itself; it never runs open).
#   cloudflare-access  (default) verify the JWT Cloudflare Access adds to each request
#   none               no authentication. Local development only; never use it on a
#                      host that other people or the internet can reach.
AUTH_MODE=cloudflare-access
# Zero Trust team domain: Zero Trust → Settings → Custom Pages (e.g. myteam.cloudflareaccess.com)
CF_ACCESS_TEAM_DOMAIN=
# The Access application's "Application Audience (AUD) Tag" (on the application's Overview tab)
CF_ACCESS_AUD=
# Comma-separated emails allowed to use the gateway. Checked by the router itself,
# in addition to the Access policy.
AUTH_ALLOWED_EMAILS=

# --- Providers (free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# --- Local models ---
# Default points at the optional `ollama` compose service.
# Use http://host.docker.internal:11434 if Ollama runs directly on the host instead.
OLLAMA_BASE_URL=http://ollama:11434

# --- Optional: Cloudflare Tunnel (compose profile "tunnel") ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Images ---
# Which published image tag compose pulls: "stable" (latest release, default), "edge"
# (latest main), or a version such as "0.1.0". Ignored when you build from source with --build.
IMAGE_TAG=stable

# --- Optional: automatic updates (compose profile "autoupdate") ---
# Absolute path of this project directory on the host. Defaults to the directory you run
# compose from; set it only if you start compose from elsewhere.
# GATEWAY_DIR=/home/pi/ai-gateway
# Seconds between checks for new images
UPDATE_INTERVAL=300
# Discord-compatible webhook URL, notified on update and rollback (empty = no notifications)
UPDATE_WEBHOOK_URL=
