# Copy to .env and fill in what you use. Leave a provider's key empty to disable it.
# Never commit .env.

# --- Gateway ---
# Port on the host where the gateway (UI + API) is served
HTTP_PORT=8080

# --- Providers (free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# --- Local models ---
# Default points at the optional `ollama` compose service.
# Use http://host.docker.internal:11434 if Ollama runs directly on the host instead.
OLLAMA_BASE_URL=http://ollama:11434

# --- Optional: Cloudflare Tunnel (compose profile "tunnel") ---
CLOUDFLARE_TUNNEL_TOKEN=
